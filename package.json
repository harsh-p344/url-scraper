{
  "name": "url-scraper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev --workspace=client\" \"npm:dev --workspace=server\"",
    "build": "npm run build --workspace=client",
    "lint": "npm run lint --workspace=client",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
